{
  "name": "iowarp-core",
  "version": "2.5.1",
  "description": "IOWarp Context Management Platform - AI-accelerated scientific workflow orchestration",
  "homepage": "https://www.iowarp.ai",
  "license": "BSD-3-Clause",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zeromq",
    "yaml-cpp",
    "cereal",
    "msgpack-c",
    "hdf5",
    "catch2"
  ],
  "features": {
    "viz": {
      "description": "Poco HTTP(S) for the runtime web dashboard and the S3 / GCS storage tiers",
      "dependencies": [
        {
          "name": "poco",
          "features": [
            "net",
            "netssl",
            "crypto",
            "json"
          ]
        }
      ]
    },
    "boost-coroutines": {
      "description": "Boost.Context stackful coroutine backend (CLIO_CORE_ENABLE_BOOST_COROUTINES, issue #620)",
      "dependencies": [
        "boost-context"
      ]
    },
    "hdf5": {
      "description": "HDF5 import in the CAE plus the HDF5 VOL connector and VFD (hdf5 is already a base dependency)"
    }
  }
}
