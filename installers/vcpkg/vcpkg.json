{
  "name": "iowarp-core",
  "version-string": "0.0.0",
  "description": "IOWarp Context Management Platform - AI-accelerated scientific workflow orchestration",
  "homepage": "https://www.iowarp.ai",
  "license": "BSD-3-Clause",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zeromq",
    "yaml-cpp",
    "cereal",
    "msgpack-c",
    "hdf5",
    "catch2"
  ],
  "features": {
    "viz": {
      "description": "Poco HTTP transport for the runtime web dashboard (and the GCS bdev / CAE Globus)",
      "dependencies": [
        {
          "name": "poco",
          "features": ["net", "netssl", "crypto", "json"]
        }
      ]
    },
    "boost-coroutines": {
      "description": "Boost.Context stackful coroutine backend (CLIO_CORE_ENABLE_BOOST_COROUTINES, issue #620)",
      "dependencies": [
        "boost-context"
      ]
    }
  }
}
