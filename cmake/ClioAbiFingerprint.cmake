#------------------------------------------------------------------------------
# ClioAbiFingerprint.cmake -- script mode (cmake -P), run at BUILD time.
#
# Hashes the runtime's public headers (and the ABI-relevant build options)
# into clio_runtime/abi_fingerprint_generated.h. Every ChiMod compiles that
# string into its get_chimod_abi() export (CLIO_TASK_CC / CLIO_CHIMOD_CC), and
# ModuleManager::LoadChiMod skips a library whose fingerprint differs from the
# runtime's own: a module built against other headers (e.g. a renamed module's
# .so left behind in bin/ by an incremental rebuild) would otherwise be loaded
# against a different Container/IpcManager layout and corrupt the heap.
#
# Inputs (-D):
#   HEADER_LIST  file holding one absolute header path per line
#   SOURCE_ROOT  root the paths are made relative to (stable across machines)
#   ABI_OPTIONS  build options that change struct layouts (free-form string)
#   OUTPUT       generated header to write
#
# The header is rewritten only when the fingerprint changes, so a re-run that
# computes the same value does not force a rebuild of everything that
# includes container.h.
#------------------------------------------------------------------------------
cmake_minimum_required(VERSION 3.16)

foreach(_var HEADER_LIST SOURCE_ROOT OUTPUT)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "ClioAbiFingerprint.cmake: -D${_var}=... is required")
  endif()
endforeach()

file(STRINGS "${HEADER_LIST}" _headers)
list(REMOVE_DUPLICATES _headers)
list(SORT _headers)

set(_acc "options:${ABI_OPTIONS}\n")
foreach(_h IN LISTS _headers)
  if(NOT EXISTS "${_h}")
    continue()  # deleted since configure; the glob is re-run on reconfigure
  endif()
  file(SHA256 "${_h}" _hh)
  file(RELATIVE_PATH _rel "${SOURCE_ROOT}" "${_h}")
  string(APPEND _acc "${_rel}:${_hh}\n")
endforeach()
string(SHA256 _full "${_acc}")
string(SUBSTRING "${_full}" 0 16 _fp)

set(_content "/* Generated by cmake/ClioAbiFingerprint.cmake -- do not edit. */
#ifndef CLIO_RUNTIME_ABI_FINGERPRINT_GENERATED_H_
#define CLIO_RUNTIME_ABI_FINGERPRINT_GENERATED_H_

/** Hash of the runtime's public headers and ABI-relevant build options. A
 *  ChiMod and the runtime that loads it must agree on this value. */
#define CLIO_RUNTIME_ABI_FINGERPRINT \"${_fp}\"

#endif  // CLIO_RUNTIME_ABI_FINGERPRINT_GENERATED_H_
")

if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old)
  if(_old STREQUAL _content)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${_content}")
