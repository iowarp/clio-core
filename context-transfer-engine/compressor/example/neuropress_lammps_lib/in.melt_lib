# LJ melt, SETUP ONLY: builds the system and declares the integrator.
#
# Same system as ../neuropress_lammps_h5/in.melt_clio (and upstream's
# in.melt_gpuc), minus two lines -- and the two lines are the point:
#
#   dump d1 all h5md ${GAP} ${OUT} position velocity force    <- not here
#   run  ${STEPS}                                              <- not here
#
# There is no dump because no file is written: the driver that loads this
# deck through liblammps reads Atom::x/v/f out of the instance itself and
# hands them to Clio. There is no run because the driver issues it, GAP steps
# at a time, so it can stand between segments and store a frame.

units           lj
atom_style      atomic
lattice         fcc 0.8442
region          box block 0 ${BOX} 0 ${BOX} 0 ${BOX}
create_box      1 box
create_atoms    1 box
mass            1 1.0
velocity        all create 3.0 87287 loop geom
pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5
neighbor        0.3 bin
neigh_modify    every 20 delay 0 check no
fix             1 all nve

# One thermo line per stored frame, like the siblings. Harmless otherwise.
thermo          ${GAP}
