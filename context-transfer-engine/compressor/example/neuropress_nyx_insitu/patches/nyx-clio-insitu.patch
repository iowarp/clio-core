@@ -1176,6 +1501,20 @@
 int
 Nyx::updateInSitu ()
 {
+    /* Clio / NeuroPress. This is Nyx's own in-situ callback -- post_timestep
+       fires it at level 0 on the `insitu.int` cadence -- so the hand-over
+       needs no plotfile and Clio ends up being the only I/O in the run.
+       Placed before the SENSEI/Ascent block, and outside its #if, so it works
+       in a build that has neither. */
+    if (nyx_clio_hook_is("insitu")) {
+        const amrex::MultiFab& S = get_new_data(State_Type);
+        amrex::Vector<std::string> nm;
+        for (int c = 0; c < S.nComp(); ++c) nm.push_back(desc_lst[State_Type].name(c));
+        nyx_clio_insitu_frame(parent, S, nm,
+                              (long long)parent->levelSteps(0),
+                              get_state_data(State_Type).curTime());
+    }
