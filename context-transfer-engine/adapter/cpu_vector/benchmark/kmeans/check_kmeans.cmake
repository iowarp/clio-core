# Run the cpu_vector k-means out of core and compare against ref.cc.
execute_process(COMMAND ${BENCH} --data-mb 32 --cache-mb 8 --iters 4 --threads 4
                OUTPUT_VARIABLE out RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "bench failed rc=${rc}: ${out}")
endif()
execute_process(COMMAND ${REF} 32 32 16 4 OUTPUT_VARIABLE ref RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "ref failed rc=${rc}")
endif()
string(REGEX MATCH "counts=([0-9,]+) csum=(-?[0-9.]+)" _ "${out}")
set(b_counts "${CMAKE_MATCH_1}")
set(b_csum "${CMAKE_MATCH_2}")
string(REGEX MATCH "counts=([0-9,]+) csum=(-?[0-9.]+)" _ "${ref}")
set(r_counts "${CMAKE_MATCH_1}")
set(r_csum "${CMAKE_MATCH_2}")
string(REGEX MATCH "evicts=([0-9]+)" _ "${out}")
set(evicts "${CMAKE_MATCH_1}")
message(STATUS "bench: ${out}")
message(STATUS "ref:   ${ref}")
if(NOT b_counts STREQUAL r_counts)
  message(FATAL_ERROR "counts differ: ${b_counts} vs ${r_counts}")
endif()
# csum: compare to 1e-2 absolute (sum of 512 floats ~ 1e3; summation order
# differs between the two). CMake math is integer-only, so scale by 100.
string(REGEX REPLACE "\\.([0-9][0-9]).*" "\\1" b100 "${b_csum}")
string(REGEX REPLACE "\\.([0-9][0-9]).*" "\\1" r100 "${r_csum}")
math(EXPR diff "${b100} - ${r100}")
if(diff GREATER 1 OR diff LESS -1)
  message(FATAL_ERROR "csum differs: ${b_csum} vs ${r_csum}")
endif()
if(evicts EQUAL 0)
  message(FATAL_ERROR "no evictions: the run was not out of core")
endif()
