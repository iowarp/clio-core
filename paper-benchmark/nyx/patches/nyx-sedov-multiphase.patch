+/**
+ * Deterministic per-cell noise in [-1, 1): a hash of the cell index and a
+ * channel, so every run (and every GPU block order) sees the same field.
+ */
+AMREX_GPU_HOST_DEVICE AMREX_FORCE_INLINE
+amrex::Real cell_noise(int i, int j, int k, int c)
+{
+  unsigned int h = static_cast<unsigned int>(i) * 73856093u ^
+                   static_cast<unsigned int>(j) * 19349663u ^
+                   static_cast<unsigned int>(k) * 83492791u ^
+                   static_cast<unsigned int>(c) * 2654435761u;
+  h ^= h >> 16; h *= 0x7feb352du; h ^= h >> 15; h *= 0x846ca68bu; h ^= h >> 16;
+  return static_cast<amrex::Real>(h & 0xffffffu) / amrex::Real(8388608.0) - amrex::Real(1.0);
+}
