 void
 Nyx::writePlotFile (const std::string& dir,
                     ostream&           os,
                     VisMF::How         how)
 {
+    /* Raw float32 dump for the standalone compression benchmark. Placed
+       before either write path so it fires whether or not this build has
+       AMReX HDF5, and driven off the hydro state rather than the assembled
+       plot MultiFab so it does not depend on derive(). */
+    {
+        const amrex::MultiFab& S = get_new_data(State_Type);
+        amrex::Vector<std::string> nm;
+        for (int c = 0; c < S.nComp(); ++c) nm.push_back(desc_lst[State_Type].name(c));
+        nyx_dump_raw_fields(parent, S, nm);
+    }
 
