+/* ---------------------------------------------------------------------------
+ * Raw field dump for the Clio/NeuroPress standalone benchmark.
+ *
+ * Writes each FArrayBox component of the hydro state as a flat float32 file,
+ * so a compressor benchmark can replay real simulation fields without linking
+ * anything into Nyx. Derived from the dump block in NeuroPress's
+ * benchmarks/nyx/patches/Nyx_output.cpp, but deliberately NOT gated on
+ * AMREX_USE_GPUCOMPRESS: nothing here calls a compressor, so the benchmark
+ * that consumes the files stays independent of whichever one produced them.
+ *
+ * Off unless NYX_DUMP_FIELDS=1. Output goes to $NYX_DUMP_DIR (default ".")
+ * as <dir>/plt%05d/fab%04d_comp%02d_<name>.f32.
+ *
+ * float32 ALWAYS, downcasting when amrex::Real is double, so a benchmark
+ * reading the files never has to ask how Nyx was configured -- and so the
+ * element size matches what the compression model was trained on.
+ * ------------------------------------------------------------------------- */
+static void
+nyx_dump_raw_fields (amrex::Amr* parent_amr, const amrex::MultiFab& mf,
+                     const amrex::Vector<std::string>& names)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* e = getenv("NYX_DUMP_FIELDS");
+        enabled = (e && atoi(e)) ? 1 : 0;
+    }
+    if (!enabled) return;
+    amrex::ignore_unused(parent_amr);
+
+    const char* raw_dir = getenv("NYX_DUMP_DIR");
+    if (!raw_dir) raw_dir = ".";
+
+    static int dump_count = 0;
+    char ts_dir[700];
+    snprintf(ts_dir, sizeof(ts_dir), "%s/plt%05d", raw_dir, dump_count);
+    amrex::UtilCreateDirectory(ts_dir, 0755);
+
+    for (amrex::MFIter mfi(mf); mfi.isValid(); ++mfi) {
+        const amrex::FArrayBox& fab = mf[mfi];
+        const long ncells = mfi.validbox().numPts();
+        for (int comp = 0; comp < mf.nComp(); ++comp) {
+            const amrex::Real* d_ptr = fab.dataPtr(comp);
+            const size_t nbytes = (size_t)ncells * sizeof(amrex::Real);
+            std::vector<char> h_buf(nbytes);
+#ifdef AMREX_USE_GPU
+            /* The FAB lives in an AMReX device/managed arena under CUDA.
+               dtoh_memcpy_async + a stream sync rather than a raw cudaMemcpy:
+               it is the portable spelling and it respects AMReX's stream. */
+            amrex::Gpu::dtoh_memcpy_async(h_buf.data(), d_ptr, nbytes);
+            amrex::Gpu::streamSynchronize();
+#else
+            std::memcpy(h_buf.data(), d_ptr, nbytes);
+#endif
+            char fpath[900];
+            snprintf(fpath, sizeof(fpath), "%s/fab%04d_comp%02d_%s.f32",
+                     ts_dir, mfi.index(), comp,
+                     (comp < (int)names.size()) ? names[comp].c_str() : "unk");
+            FILE* fp = fopen(fpath, "wb");
+            if (fp) {
+                if (sizeof(amrex::Real) == 8) {
+                    std::vector<float> f32((size_t)ncells);
+                    const double* src = reinterpret_cast<const double*>(h_buf.data());
+                    for (long i = 0; i < ncells; ++i) f32[i] = (float)src[i];
+                    fwrite(f32.data(), sizeof(float), (size_t)ncells, fp);
+                } else {
+                    fwrite(h_buf.data(), sizeof(float), (size_t)ncells, fp);
+                }
+                fclose(fp);
+            }
+        }
+    }
+    ++dump_count;
+}
