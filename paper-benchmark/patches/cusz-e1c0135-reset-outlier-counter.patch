@@ -135,6 +152,12 @@ PPL_IMPL(int)::compress(psz_ctx* ctx, PSZ_BUF* mem, T* in, u1** out, size_t* out
   const HFR_Opts hfr_opts{ctx->cli ? ctx->cli->hfr_rmerge_count : 3};
 
   auto compress_predict = [&]() -> int {
+    /* Zeroed for EVERY predictor, not just Spline -- see compress_analysis
+       above. This is the reset that makes a psz_resource safe to reuse across
