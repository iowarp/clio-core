# Submodules managed by .gitmodules
#external/libzmq/

claude-log.json

# Benchmark output trees (logs/csv/raw/progress.log). The DRIVERS are tracked (e.g.
# context-transfer-engine/adapter/kvhdf5/test/e2e/scaling_campaign/run_campaign.sh);
# their multi-hundred-MB results are not. Override per-run with CAMPAIGN_RESULTS=<dir>.
bench_results/

# Windows firewall allow-rule marker (scripts/windows/allow_firewall.ps1)
.clio_firewall_allowed
context-runtime/test/integration/collective_restart/docker-compose.override.yml
build-tsan/

# Local-only compose overrides (per-box mounts/debug shims) must never be committed
docker-compose.override.yml

# Local-only ASan/backtrace debug shim (issue #856) — built ad hoc inside the
# test containers, never part of the build.
abrt_bt.c
abrt_bt.so

# Per-session HDF5 artifacts written by demo/benchmark runs (UUID-named .h5).
# Generated output, never source.
demologs/

# Paper-benchmark run output. The DRIVERS (paper-benchmark/*/run_*.sh,
# collect.py, decks, README) are tracked; the results trees they write --
# per-chunk CSVs, LAMMPS logs, the tier and its metadata log -- are generated
# and can run to hundreds of MB. Override the location with --results DIR.
paper-benchmark/*/results/
# The TOP-LEVEL results tree, which is where run_benchmark.sh actually writes
# by default (RESULTS=$HERE/results/benchmark). The glob above only covers a
# per-workload results/ one level down, so without this line a whole campaign
# -- every cell's CSVs, logs and tier files -- shows up as untracked and lands
# in the next `git add -A`.
paper-benchmark/results/
# Nyx field dumps: gigabytes of simulation output regenerated by gen_fields.sh.
paper-benchmark/nyx/fields/
# VPIC field dumps and the compiled deck. build_deck.sh rebuilds the binary;
# gen_fields.sh regenerates the fields. The DECK SOURCE is tracked.
paper-benchmark/vpic/fields/
paper-benchmark/vpic/*.Linux
paper-benchmark/vpic/build_deck.log
# VPIC writes its own energy diagnostic into the working directory on every
# run; it is simulation output, not source.
paper-benchmark/vpic/energies
# VPIC writes its `energies` table into the directory it is RUN from, not its
# deck's, so an in-situ run started from the example dir or the repo root drops
# one there instead. Simulation output wherever it lands, never source.
**/energies
# WarpX writes openPMD output and per-run stores under results/.
paper-benchmark/warpx/results/
# Gray-Scott writes its HDF5, its reference dump and per-run stores under
# results/. The harness scripts are tracked; what a run produces is not.
paper-benchmark/grayscott/results/
